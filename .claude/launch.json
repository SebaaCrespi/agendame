{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8000"],
      "cwd": "backend",
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 5173
    },
    {
      "name": "backend-rediseno",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8001"],
      "cwd": "backend",
      "port": 8001,
      "env": {
        "JWT_SECRET_KEY": "dev-only-secret-for-redesign-preview-0001",
        "DATABASE_URL": "sqlite+aiosqlite:///./agendame-rediseno.db"
      }
    },
    {
      "name": "frontend-rediseno",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5174", "--strictPort"],
      "cwd": "frontend",
      "port": 5174,
      "env": { "VITE_API_URL": "http://localhost:5174", "VITE_PROXY_TARGET": "http://localhost:8001" }
    }
  ]
}
