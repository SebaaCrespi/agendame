# Variables para docker compose (copiar como .env en esta carpeta).
# Todas son opcionales: sin .env la app levanta igual, pero el asistente no responde.

# Chatbot: key gratuita en https://console.groq.com/keys
GROQ_API_KEY=
CHAT_PROVIDER=groq
CHAT_MODEL=openai/gpt-oss-120b

# Cargar datos de demo al iniciar (true/false)
SEED_DEMO=true

# Puertos (por si 5173 u 8000 están ocupados)
# FRONTEND_PORT=5173
# BACKEND_PORT=8000
